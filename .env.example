# Invoicing — keep credentials server-only. Automatic invoicing stays disabled until the tenant connection is successfully verified in Admin.
INVOICE_PROVIDER=szamlazz
SZAMLAZZ_AGENT_KEY=
SZAMLAZZ_EINVOICE=false
SZAMLAZZ_DUE_DAYS=8
SZAMLAZZ_INVOICE_PREFIX=
SZAMLAZZ_BANK_NAME=
SZAMLAZZ_BANK_ACCOUNT=
SZAMLAZZ_REPLY_TO=
