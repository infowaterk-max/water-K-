{
  "version": 1,
  "name": "Shoperation Production Release Risk Budget",
  "maxPoints": 5,
  "maxSubsystems": 3,
  "riskWeights": {
    "low": 1,
    "medium": 2,
    "high": 5
  },
  "neutralPatterns": [
    "docs/**",
    "tests/**",
    "artifacts/**",
    "**/*.md",
    "**/*.snap",
    ".gitignore",
    "quality/development/**"
  ],
  "subsystems": [
    {
      "name": "database-schema",
      "risk": "high",
      "patterns": [
        "supabase/**/*.sql",
        "supabase/migrations/**",
        "supabase/customer-baseline/**"
      ]
    },
    {
      "name": "auth-access-authority",
      "risk": "high",
      "patterns": [
        "src/lib/auth/**",
        "src/middleware.ts",
        "src/app/api/auth/**"
      ]
    },
    {
      "name": "storefront-launch-runtime",
      "risk": "high",
      "patterns": [
        "src/lib/builder/storefront-runtime-source.ts",
        "src/lib/storefront/access/**",
        "src/lib/storefront/launch/**"
      ]
    },
    {
      "name": "environment-secret-contract",
      "risk": "high",
      "patterns": [
        "scripts/validate-vercel-deploy-env.mjs",
        "deploy/env.schema.json"
      ]
    },
    {
      "name": "payment-checkout-order-authority",
      "risk": "high",
      "patterns": [
        "src/lib/payment/**",
        "src/lib/payments/**",
        "src/lib/orders/**",
        "src/app/api/payment/**",
        "src/app/api/payments/**",
        "src/app/api/checkout/**",
        "src/lib/commerce/cart-engine.ts",
        "src/lib/commerce/checkout-quote.ts",
        "src/lib/commerce/pricing.ts",
        "src/lib/commerce/providers.ts",
        "src/lib/commerce/settings.ts"
      ]
    },
    {
      "name": "inventory-fulfillment-authority",
      "risk": "high",
      "patterns": [
        "src/lib/inventory/**",
        "src/lib/shipping/**",
        "src/lib/fulfillment/**",
        "src/app/api/inventory/**",
        "src/app/api/shipping/**",
        "src/app/api/fulfillment/**"
      ]
    },
    {
      "name": "incident-intelligence",
      "risk": "medium",
      "patterns": [
        "src/lib/incidents/**",
        "src/app/api/incidents/**",
        "src/app/api/platform/incidents/**",
        "src/app/admin/platform/incidents/**",
        "src/components/admin/platform-incident-center.tsx"
      ]
    },
    {
      "name": "builder-template-system",
      "risk": "medium",
      "patterns": [
        "src/lib/builder/**",
        "src/app/admin/builder/**",
        "src/components/builder/**",
        "public/storefront-demo/**"
      ]
    },
    {
      "name": "admin-operations",
      "risk": "medium",
      "patterns": [
        "src/app/admin/**",
        "src/components/admin/**",
        "src/lib/admin/**"
      ]
    },
    {
      "name": "customer-account",
      "risk": "medium",
      "patterns": [
        "src/app/fiokom/**",
        "src/lib/customer/**",
        "src/components/account/**",
        "src/lib/account/**"
      ]
    },
    {
      "name": "shared-storefront",
      "risk": "medium",
      "patterns": [
        "src/lib/storefront/**",
        "src/components/storefront/**"
      ]
    },
    {
      "name": "commerce-read-model-authority",
      "risk": "medium",
      "patterns": [
        "src/lib/commerce/commerce-automation-recovery.ts",
        "src/lib/commerce/compatibility-engine.ts",
        "src/lib/commerce/context-profile.ts",
        "src/lib/commerce/guided-finder.ts",
        "src/lib/commerce/hu-tax-number.ts",
        "src/lib/commerce/interactive-scene.ts",
        "src/lib/commerce/multi-product-composer.ts",
        "src/lib/commerce/product-configurator.ts",
        "src/lib/commerce/product-discovery.ts",
        "src/lib/commerce/professional-b2b.ts",
        "src/lib/commerce/recipe-commerce.ts",
        "src/lib/commerce/release-commerce.ts",
        "src/lib/commerce/retention-reorder.ts",
        "src/lib/commerce/roadmap-block15.ts",
        "src/lib/commerce/room-scene-composer.ts",
        "src/lib/commerce/structured-product.ts"
      ]
    },
    {
      "name": "content-authority",
      "risk": "medium",
      "patterns": [
        "src/lib/content/**"
      ]
    },
    {
      "name": "quality-infrastructure",
      "risk": "medium",
      "patterns": [
        "scripts/shoperation-*.mjs",
        "scripts/lib/shoperation-*.mjs",
        "src/lib/quality-system/**",
        "quality/knowledge/**",
        "scripts/template-factory-product-owner-handoff.mjs",
        "scripts/template-factory-quality-gate.mjs",
        "scripts/shoperation-*.d.mts",
        "scripts/lib/shoperation-*.d.mts"
      ]
    },
    {
      "name": "release-infrastructure",
      "risk": "medium",
      "patterns": [
        ".github/workflows/**",
        "scripts/release-*.mjs",
        "scripts/smoke.mjs",
        "deploy/release-risk-policy.json",
        "next.config.ts",
        "quality/knowledge/domain-foundations.v1.json"
      ]
    },
    {
      "name": "dependency-contract",
      "risk": "medium",
      "patterns": [
        "package.json",
        "package-lock.json"
      ]
    },
    {
      "name": "storefront-ui",
      "risk": "low",
      "patterns": [
        "src/app/**",
        "src/components/**",
        "src/styles/**",
        "**/*.css"
      ]
    }
  ],
  "fallback": {
    "subsystem": "unclassified-change",
    "risk": "medium"
  }
}
