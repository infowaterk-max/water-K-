{
  "contract": "shoporation.codebase-atlas-policy.v2",
  "version": 2,
  "architectureContracts": {
    "constitution": "shoporation.architecture-constitution.v1",
    "domains": "shoporation.domain-foundations.v1"
  },
  "domainAuthoritySource": "quality/knowledge/domain-foundations.v1.json",
  "constitutionSource": "quality/knowledge/architecture-constitution.v1.json",
  "textExtensions": [
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs",
    ".json",
    ".css",
    ".scss",
    ".sql",
    ".md",
    ".yml",
    ".yaml"
  ],
  "sourceExtensions": [
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs"
  ],
  "excludedPrefixes": [
    "node_modules/",
    "artifacts/",
    ".next/",
    "coverage/"
  ],
  "surfaceRules": [
    {
      "id": "platform-admin",
      "patterns": [
        "src/app/admin/platform/**",
        "src/lib/auth/platform-operator.ts"
      ],
      "label": "Platform administration"
    },
    {
      "id": "merchant-admin",
      "patterns": [
        "src/app/admin/**",
        "src/components/admin/**"
      ],
      "label": "Merchant administration"
    },
    {
      "id": "customer-account",
      "patterns": [
        "src/app/fiokom/**",
        "src/components/account/**",
        "src/lib/customer/**"
      ],
      "label": "Customer account"
    },
    {
      "id": "storefront-runtime",
      "patterns": [
        "src/components/builder/storefront-**",
        "src/lib/builder/storefront-**",
        "src/components/storefront/**",
        "src/lib/storefront/**"
      ],
      "label": "Storefront runtime / presentation"
    },
    {
      "id": "public-api",
      "patterns": [
        "src/app/api/**"
      ],
      "label": "Public/server API"
    },
    {
      "id": "database",
      "patterns": [
        "supabase/**"
      ],
      "label": "Database / RPC / RLS"
    },
    {
      "id": "quality-system",
      "patterns": [
        "quality/**",
        "scripts/shoperation-**",
        "scripts/lib/shoperation-**"
      ],
      "label": "Quality knowledge / engineering controls"
    }
  ],
  "criticalLookups": [
    {
      "term": "support.contact-form",
      "requiredFiles": [
        "src/lib/builder/storefront-support.ts",
        "src/components/builder/storefront-support.tsx"
      ]
    },
    {
      "term": "StorefrontFormWizard",
      "requiredFiles": [
        "src/components/forms/storefront-form-wizard.tsx"
      ]
    },
    {
      "term": "create_support_ticket_v2",
      "requiredFiles": [
        "src/app/api/support/route.ts",
        "supabase/migrations/20260903185000_support_submission_atomic_v2.sql"
      ]
    }
  ],
  "maxImpactTraversal": 300,
  "maxImpactResults": 40,
  "selfKnowledge": {
    "mapDomainsFromCanonicalPaths": true,
    "exposeAuthorityOwners": true,
    "exposeTruthOwnership": true,
    "includeDomainDependencyClosure": true,
    "includeBoundaryRules": true,
    "includeEvidenceObligations": true,
    "includeKnownFailureRegressionAuthority": true,
    "includeReverseConsumers": true,
    "includeChangeObligations": true,
    "includeDocumentationReferences": true
  },
  "changeObligationRules": [
    {
      "id": "ATLAS-OBL-001",
      "name": "Reverse consumer revalidation",
      "sourcePatterns": [
        "**"
      ],
      "kind": "revalidate-consumers",
      "timing": "before-handoff",
      "targetSource": "atlas.reverseImports",
      "mutationPolicy": "review-and-update-if-contract-changed",
      "reason": "A changed authority or component can invalidate downstream consumers even when those consumer files are not direct edit targets.",
      "closurePhase": "pre-gate"
    },
    {
      "id": "ATLAS-OBL-002",
      "name": "Regression authority revalidation",
      "sourcePatterns": [
        "**"
      ],
      "kind": "revalidate-regression-tests",
      "timing": "before-handoff",
      "targetSource": "atlas.discoveredTests",
      "mutationPolicy": "review-and-update-if-expected-contract-changed",
      "reason": "Tests that consume the changed source must be identified during planning rather than discovered after implementation.",
      "closurePhase": "pre-gate"
    },
    {
      "id": "ATLAS-OBL-003",
      "name": "Documentation and description reference review",
      "sourcePatterns": [
        "**"
      ],
      "kind": "review-documentation-references",
      "timing": "same-change-if-description-became-stale",
      "targetSource": "atlas.fileReferenceIndex",
      "mutationPolicy": "review-required-update-if-stale",
      "reason": "Repository descriptions and architecture/support notes that explicitly reference a changed file must be reviewed with the source change.",
      "closurePhase": "pre-gate"
    },
    {
      "id": "ATLAS-OBL-004",
      "name": "Template browser evidence regeneration",
      "sourcePatterns": [
        "src/lib/builder/templates/**",
        "src/lib/builder/storefront-**",
        "src/components/builder/storefront-**",
        "src/app/storefront-template-preview/**",
        "src/app/visual-fidelity-qa/**"
      ],
      "kind": "regenerate-derived-evidence",
      "timing": "same-change-before-handoff",
      "targetPatterns": [
        "artifacts/template-factory-quality/manifest.json",
        "artifacts/template-factory-quality/*.png"
      ],
      "mutationPolicy": "generated-evidence-only",
      "reason": "Template/runtime presentation changes require fresh exact-head browser proof.",
      "closurePhase": "specialist",
      "closureEvidenceGuardId": "GUARD-TEMPLATE-FACTORY"
    },
    {
      "id": "ATLAS-OBL-005",
      "name": "Template golden baseline lifecycle",
      "sourcePatterns": [
        "src/lib/builder/templates/**",
        "src/lib/builder/storefront-**",
        "src/components/builder/storefront-**",
        "src/app/storefront-template-preview/**",
        "src/app/visual-fidelity-qa/**",
        "tests/visual-baselines/**"
      ],
      "kind": "deferred-golden-baseline-promotion",
      "timing": "after-explicit-product-owner-visual-acceptance",
      "targetPatterns": [
        "tests/visual-baselines/**"
      ],
      "mutationPolicy": "forbidden-before-explicit-product-owner-acceptance",
      "reason": "Golden differences are expected evidence of a visual change; baselines may be promoted only after explicit Product Owner visual acceptance.",
      "closurePhase": "human-approval"
    },
    {
      "id": "ATLAS-OBL-006",
      "name": "Quality contract documentation sync",
      "sourcePatterns": [
        "quality/knowledge/**",
        "scripts/shoperation-**",
        "scripts/lib/shoperation-**",
        "scripts/template-factory-**",
        ".github/workflows/**"
      ],
      "kind": "review-quality-contract-documentation",
      "timing": "same-change-if-contract-changed",
      "targetPatterns": [
        "docs/architecture/**",
        "docs/support/**",
        "AGENTS.md"
      ],
      "mutationPolicy": "review-required-update-if-stale",
      "reason": "Changes to planning, authority, orchestration or quality contracts must not leave repository operating instructions describing the previous contract.",
      "closurePhase": "pre-gate"
    }
  ]
}
