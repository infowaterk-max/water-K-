{
  "contract": "shoporation.authority-conflict-policy.v1",
  "version": 1,
  "status": "canonical",
  "principles": {
    "authorityOwnershipMustBeMachineCheckable": true,
    "delegatedPresentationMustNotReplaceOwnedBehavior": true,
    "authorityContinuityRequiresCanonicalEvidence": true,
    "conflictEvaluationIsSharedControlPlaneCapability": true
  },
  "policies": [
    {
      "id": "AUTH-CONFLICT-TF-AUTH-005-COMMERCE",
      "authorityRuleId": "TF-AUTH-005",
      "owner": "platform",
      "delegatedOwner": "template",
      "rule": "Shared commerce behavior remains platform-owned; template evidence may prove presentation only.",
      "subjects": [
        {
          "subject": "checkout",
          "detectPattern": "\\bcheckout\\b|p[eé]nzt[aá]r|pageType.?checkout|\\/penztar|components\\/checkout",
          "pageType": "checkout",
          "forbiddenTemplateCheckPattern": "form|field|input|shipping|payment|submit|step|accordion",
          "forbiddenTemplateNodePattern": "form-preview|field-|shipping-methods|payment-collapsed|summary-collapsed",
          "forbiddenTemplateComponentPattern": "^(content|layout)\\.",
          "canonicalEvidence": [
            {
              "file": "src/app/penztar/page.tsx",
              "value": "<CheckoutForm"
            },
            {
              "file": "src/app/penztar/page.tsx",
              "value": "<StorefrontCheckoutShell"
            },
            {
              "file": "src/components/checkout/storefront-checkout-shell.tsx",
              "value": "data-storefront-live-checkout=\"shared-e13\""
            },
            {
              "file": "src/components/checkout/checkout-form.tsx",
              "value": "data-checkout-ux=\"guided-accordion\""
            }
          ]
        },
        {
          "subject": "cart",
          "detectPattern": "\\bcart\\b|kos[aá]r|pageType.?cart|components\\/cart",
          "pageType": "cart",
          "forbiddenTemplateCheckPattern": "quantity|remove|coupon|submit|stepper|add-to-cart"
        },
        {
          "subject": "account",
          "detectPattern": "\\baccount\\b|fi[oó]k|pageType.?account|components\\/account",
          "pageType": "account",
          "forbiddenTemplateCheckPattern": "login|logout|profile|order|return|download"
        }
      ]
    }
  ]
}
