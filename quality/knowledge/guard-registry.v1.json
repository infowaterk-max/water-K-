      "authority": "release-infrastructure",
      "lifecycle": "release",
      "blocking": true,
      "responsibilityKey": "static-type-contract",
      "producer": "tsc --noEmit",
      "evidence": "workflow-step",
      "execution": {
        "mode": "external-specialist",
        "profiles": [
          "pr",
          "post-merge",
          "branch",
          "full-replay",
          "template-pr",
          "template-branch"
        ],
        "command": "npm",
        "args": [
          "run",
          "typecheck"
