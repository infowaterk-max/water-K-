        "GUARD-TYPECHECK",
        "GUARD-PRODUCTION-BUILD"
      ],
      "authoritySources": [
        "artifacts/shoperation-control-plane/control-plane.json"
      ],
      "controlPlaneEvidence": "artifacts/shoperation-control-plane/external-guard-template-factory.json",
      "diagnosticSources": [
        {
          "file": "artifacts/template-factory-quality/manifest.json",
          "arrayPath": "errors",
          "codeField": "error",
          "contextFields": [
            "case",
            "pageType",
            "viewport"
