  "intelligencePolicy": {
    "mode": "deterministic-control-plane-first",
    "aiLayerStatus": "not-enabled-until-deterministic-consistency",
    "advisoryRepairSuggestionsAllowed": true,
    "selfHealing": {
      "allowed": "pre-authorized-low-risk-reversible-only",
      "explicitAuthorityRequiredFor": [
        "production",
        "migration",
        "security",
        "payment",
        "auth",
        "destructive"
      ],
      "productOwnerDecisionOverrideAllowed": false
    }
  },
  "authorityConflictContracts": [
    {
      "id": "AUTH-CONFLICT-TF-AUTH-005-CHECKOUT",
      "authorityRuleId": "TF-AUTH-005",
      "owner": "platform",
      "delegatedOwner": "template",
      "instructionPattern": "\\bcheckout\\b|p[eé]nzt[aá]r|pageType.?checkout|/penztar|components/checkout",
      "forbiddenTemplateEvidence": {
        "pageType": "checkout",
        "nodePattern": "form-preview|field-|shipping-methods|payment-collapsed|summary-collapsed",
        "componentKeyPattern": "^(content|layout)\\."
      },
      "requiredAuthorityEvidence": [
        {
          "kind": "authority-source-contains",
          "file": "src/app/penztar/page.tsx",
          "value": "<CheckoutForm"
        },
        {
          "kind": "authority-source-contains",
          "file": "src/app/penztar/page.tsx",
          "value": "<StorefrontCheckoutShell"
        },
        {
          "kind": "authority-source-contains",
          "file": "src/components/checkout/storefront-checkout-shell.tsx",
          "value": "data-storefront-live-checkout=\"shared-e13\""
        },
        {
          "kind": "authority-source-contains",
          "file": "src/components/checkout/checkout-form.tsx",
          "value": "data-checkout-ux=\"guided-accordion\""
        }
      ]
    },
    {
      "id": "AUTH-CONFLICT-TF-AUTH-005-CART",
      "authorityRuleId": "TF-AUTH-005",
      "owner": "platform",
      "delegatedOwner": "template",
      "instructionPattern": "\\bcart\\b|kos[aá]r|pageType.?cart|components/cart",
      "forbiddenTemplateEvidence": {
        "pageType": "cart",
        "nodePattern": "quantity|remove|coupon|submit|stepper|add-to-cart",
        "componentKeyPattern": "^(content|layout)\\."
      },
      "requiredAuthorityEvidence": []
    },
    {
      "id": "AUTH-CONFLICT-TF-AUTH-005-ACCOUNT",
      "authorityRuleId": "TF-AUTH-005",
      "owner": "platform",
      "delegatedOwner": "template",
      "instructionPattern": "\\baccount\\b|fi[oó]k|pageType.?account|components/account",
      "forbiddenTemplateEvidence": {
        "pageType": "account",
        "nodePattern": "login|logout|profile|order|return|download",
        "componentKeyPattern": "^(content|layout)\\."
      },
      "requiredAuthorityEvidence": []
    }
  ]
