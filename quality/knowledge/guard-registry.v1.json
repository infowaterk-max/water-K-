{
  "contract": "shoporation.guard-registry.v1",
  "version": 1,
  "status": "canonical",
  "principles": {
    "oneBlockingResponsibilityOneOwner": true,
    "additiveGuardsRequireDistinctResponsibility": true,
    "evidenceMustNameProducer": true,
    "informationalSignalsMustNotMasqueradeAsBlockingAuthorities": true
  },
  "guards": [
    {
      "id": "GUARD-KNOWLEDGE-PREFLIGHT",
      "name": "Knowledge Before Build",
      "authority": "quality-knowledge-system",
      "lifecycle": "development",
      "blocking": true,
      "responsibilityKey": "knowledge-integrity-and-change-impact",
      "producer": "scripts/shoperation-knowledge-preflight.mjs",
      "evidence": "artifacts/shoperation-quality/knowledge-preflight.json",
      "verification": {
        "reusePolicy": "never",
        "dependsOn": [],
        "impactTier": 4,
        "shadowComparable": true,
        "knownFailureConsumer": true,
        "semanticInputs": [
          "quality/knowledge/**",
          "src/lib/quality-system/**",
          "src/lib/builder/template-factory/knowledge-registry.ts",
          "scripts/shoperation-knowledge-*",
          "scripts/lib/shoperation-codebase-atlas-runtime.mjs"
        ],
        "configurationInputs": [
          "quality/development/active-plan.json",
          ".github/workflows/ci.yml"
        ]
      }
    },
    {
      "id": "GUARD-PLAN-BEFORE-CODE",
      "name": "Plan Before Code",
      "authority": "quality-knowledge-system",
      "lifecycle": "development",
      "blocking": true,
      "responsibilityKey": "declared-change-scope",
      "producer": "scripts/shoperation-plan-before-code.mjs",
      "evidence": "artifacts/shoperation-development-guard/plan-before-code.json",
      "verification": {
        "reusePolicy": "never",
        "dependsOn": [
          "GUARD-KNOWLEDGE-PREFLIGHT"
        ],
        "impactTier": 4,
        "shadowComparable": true,
        "semanticInputs": [
          "quality/development/active-plan.json",
          "quality/knowledge/**",
          "scripts/shoperation-plan-before-code.mjs",
          "scripts/lib/shoperation-development-runtime.mjs",
          "scripts/lib/shoperation-operational-intelligence.mjs"
        ],
        "configurationInputs": [
          ".github/workflows/ci.yml"
        ]
      }
    },
    {
      "id": "GUARD-EDIT-TIME",
      "name": "Edit-Time Known Failure Guard",
      "authority": "quality-knowledge-system",
      "lifecycle": "development",
      "blocking": true,
      "responsibilityKey": "known-failure-edit-selection",
      "producer": "scripts/shoperation-edit-time-guard.mjs",
      "evidence": "artifacts/shoperation-development-guard/edit-time-guard.json",
      "verification": {
        "reusePolicy": "never",
        "dependsOn": [
          "GUARD-PLAN-BEFORE-CODE"
        ],
        "impactTier": 3,
        "shadowComparable": true,
        "knownFailureConsumer": true,
        "semanticInputs": [
          "quality/knowledge/**",
          "scripts/shoperation-edit-time-guard.mjs",
          "scripts/lib/shoperation-reference-sync-runtime.mjs",
          "scripts/lib/shoperation-development-runtime.mjs"
        ],
        "configurationInputs": [
          "quality/development/active-plan.json"
        ]
      }
    },
    {
      "id": "GUARD-INCREMENTAL-REPLAY",
      "name": "Incremental Known Failure Replay",
      "authority": "quality-knowledge-system",
      "lifecycle": "development",
      "blocking": true,
      "responsibilityKey": "known-failure-regression-replay",
      "producer": "scripts/shoperation-incremental-replay.mjs",
      "evidence": "artifacts/shoperation-development-guard/incremental-replay.json",
      "verification": {
        "reusePolicy": "never",
        "dependsOn": [
          "GUARD-EDIT-TIME"
        ],
        "impactTier": 2,
        "shadowComparable": true,
        "knownFailureConsumer": true,
        "semanticInputs": [
          "quality/knowledge/**",
          "tests/**",
          "scripts/shoperation-incremental-replay.mjs",
          "scripts/lib/shoperation-verification-reuse.mjs",
          "scripts/lib/shoperation-development-runtime.mjs"
        ],
        "configurationInputs": [
          "quality/development/active-plan.json",
          ".github/workflows/ci.yml"
        ]
      }
    },
    {
      "id": "GUARD-COMPLETION-TRUTH",
      "name": "Completion Truth Gate",
      "authority": "quality-knowledge-system",
      "lifecycle": "development-completion",
      "blocking": true,
      "responsibilityKey": "po-completion-integrity",
      "producer": "scripts/shoperation-truth-gate.mjs",
      "evidence": "artifacts/shoperation-development-guard/truth-gate.json",
      "verification": {
        "reusePolicy": "never",
        "dependsOn": [
          "GUARD-INCREMENTAL-REPLAY",
          "GUARD-QUALITY-TESTS",
          "GUARD-TYPECHECK",
          "GUARD-PRODUCTION-BUILD"
        ],
        "impactTier": 4,
        "shadowComparable": false,
        "semanticInputs": [
          "quality/development/active-plan.json",
          "scripts/shoperation-truth-gate.mjs",
          "scripts/lib/shoperation-operational-intelligence.mjs"
        ],
        "configurationInputs": [
          ".github/workflows/ci.yml"
        ]
      }
    },
    {
      "id": "GUARD-RELEASE-RISK",
      "name": "Release Risk Budget",
      "authority": "release-infrastructure",
      "lifecycle": "release",
      "blocking": true,
      "responsibilityKey": "release-coherence-risk-budget",
      "producer": "scripts/release-risk-budget.mjs",
      "evidence": "artifacts/release-risk-budget.json",
      "verification": {
        "reusePolicy": "never",
        "dependsOn": [],
        "impactTier": 4,
        "shadowComparable": true,
        "semanticInputs": [
          "deploy/release-risk-policy.json",
          "scripts/release-risk-budget.mjs"
        ],
        "configurationInputs": [
          ".github/workflows/ci.yml"
        ]
      }
    },
    {
      "id": "GUARD-CUSTOMER-BASELINE",
      "name": "Customer Database Baseline",
      "authority": "database-schema",
      "lifecycle": "release",
      "blocking": true,
      "responsibilityKey": "customer-schema-baseline",
      "producer": "scripts/customer-baseline-guard.mjs",
      "evidence": "artifacts/customer-baseline/**",
      "verification": {
        "reusePolicy": "safe",
        "dependsOn": [],
        "impactTier": 3,
        "shadowComparable": true,
        "semanticInputs": [
          "supabase/customer-baseline/**",
          "supabase/migrations/**",
          "scripts/validate-customer-baseline.mjs",
          "scripts/customer-baseline-*"
        ],
        "configurationInputs": [
          "package.json"
        ]
      }
    },
    {
      "id": "GUARD-MARKET-READY",
      "name": "Block 24 Market Ready Contract",
      "authority": "release-infrastructure",
      "lifecycle": "release",
      "blocking": true,
      "responsibilityKey": "market-ready-contract",
      "producer": "scripts/block24-market-ready-contract.mjs",
      "evidence": "artifacts/block24-market-ready/**",
      "verification": {
        "reusePolicy": "safe",
        "dependsOn": [
          "GUARD-CUSTOMER-BASELINE"
        ],
        "impactTier": 3,
        "shadowComparable": true,
        "semanticInputs": [
          "scripts/block24-market-ready-*",
          "src/**",
          "supabase/migrations/**",
          "deploy/**"
        ],
        "configurationInputs": [
          "package.json"
        ]
      }
    },
    {
      "id": "GUARD-QUALITY-TESTS",
      "name": "Quality Test Suite",
      "authority": "quality-knowledge-system",
      "lifecycle": "release",
      "blocking": true,
      "responsibilityKey": "automated-regression-suite",
      "producer": "npm test",
      "evidence": "test-result",
      "verification": {
        "reusePolicy": "safe",
        "dependsOn": [],
        "impactTier": 2,
        "shadowComparable": true,
        "knownFailureConsumer": true,
        "semanticInputs": [
          "src/**",
          "tests/**",
          "scripts/**",
          "quality/**",
          "supabase/**",
          "deploy/**",
          "next.config.*",
          "tsconfig.json",
          "vitest.config.*"
        ],
        "configurationInputs": [
          "package.json",
          ".github/workflows/ci.yml"
        ]
      }
    },
    {
      "id": "GUARD-TYPECHECK",
      "name": "TypeScript Check",
      "authority": "release-infrastructure",
      "lifecycle": "release",
      "blocking": true,
      "responsibilityKey": "static-type-contract",
      "producer": "tsc --noEmit",
      "evidence": "workflow-step",
      "verification": {
        "reusePolicy": "safe",
        "dependsOn": [],
        "impactTier": 2,
        "shadowComparable": true,
        "semanticInputs": [
          "src/**/*.ts",
          "src/**/*.tsx",
          "tests/**/*.ts",
          "tests/**/*.tsx",
          "scripts/**/*.mjs",
          "tsconfig.json",
          "next-env.d.ts"
        ],
        "configurationInputs": [
          "package.json"
        ]
      }
    },
    {
      "id": "GUARD-PRODUCTION-BUILD",
      "name": "Production Build",
      "authority": "release-infrastructure",
      "lifecycle": "release",
      "blocking": true,
      "responsibilityKey": "production-buildability",
      "producer": "next build",
      "evidence": "workflow-step",
      "verification": {
        "reusePolicy": "safe",
        "dependsOn": [
          "GUARD-TYPECHECK"
        ],
        "impactTier": 3,
        "shadowComparable": true,
        "semanticInputs": [
          "src/**",
          "public/**",
          "scripts/validate-vercel-deploy-env.mjs",
          "next.config.*",
          "tsconfig.json"
        ],
        "configurationInputs": [
          "package.json",
          ".github/workflows/ci.yml"
        ],
        "context": {
          "environment": "ci-build"
        }
      }
    },
    {
      "id": "GUARD-TEMPLATE-FACTORY",
      "name": "Template Factory Quality Gate v2",
      "authority": "builder-template-system",
      "lifecycle": "template-acceptance",
      "blocking": true,
      "responsibilityKey": "template-factory-browser-contract",
      "producer": ".github/workflows/template-factory-quality-gate.yml",
      "evidence": "artifacts/template-factory-quality/**",
      "verification": {
        "reusePolicy": "safe",
        "dependsOn": [
          "GUARD-PRODUCTION-BUILD"
        ],
        "impactTier": 3,
        "shadowComparable": false,
        "semanticInputs": [
          "src/lib/builder/**",
          "src/app/**",
          "src/components/**",
          "public/**",
          "scripts/template-factory-*",
          "tests/**template-factory**",
          "tests/storefront-*.test.ts",
          "quality/knowledge/**"
        ],
        "configurationInputs": [
          ".github/workflows/template-factory-quality-gate.yml"
        ],
        "context": {
          "pageMatrix": 14,
          "viewports": [
            "desktop",
            "tablet",
            "mobile"
          ],
          "visualProof": true
        }
      }
    },
    {
      "id": "SIGNAL-ARCHITECTURE-CONFIDENCE",
      "name": "Architecture Confidence",
      "authority": "quality-knowledge-system",
      "lifecycle": "observation",
      "blocking": false,
      "responsibilityKey": "architecture-confidence-signal",
      "producer": "scripts/lib/shoperation-architecture-health.mjs",
      "evidence": "artifacts/shoperation-architecture/architecture-health.json"
    },
    {
      "id": "SIGNAL-DEEP-ATLAS-SCAN",
      "name": "Daily Deep Atlas Scan",
      "authority": "quality-knowledge-system",
      "lifecycle": "observation",
      "blocking": false,
      "responsibilityKey": "scheduled-system-self-knowledge-observation",
      "producer": "scripts/shoperation-knowledge-deep-atlas-scan.mjs",
      "evidence": "artifacts/shoperation-deep-atlas/deep-atlas-scan.json"
    },
    {
      "id": "SIGNAL-SENTINEL",
      "name": "Shoperation Sentinel",
      "authority": "quality-knowledge-system",
      "lifecycle": "observation",
      "blocking": false,
      "responsibilityKey": "scheduled-quality-trend-observation",
      "producer": "scripts/shoperation-sentinel-scan.mjs",
      "evidence": "artifacts/shoperation-sentinel/sentinel-report.json"
    }
  ],
  "verificationReuse": {
    "contract": "shoporation.verification-reuse-registry.v1",
    "schemaVersion": "shoporation.verification-reuse.v1",
    "mode": "shadow",
    "branchScoped": true,
    "crossBranchReuse": false,
    "unknownPolicy": "rerun",
    "forceFullOnUnknownDependency": true,
    "globalAuthorityInputs": [
      "quality/knowledge/architecture-constitution.v1.json",
      "quality/knowledge/domain-foundations.v1.json"
    ],
    "globalToolchainInputs": [
      "package.json",
      "package-lock.json"
    ],
    "globalEnvironmentKeys": [
      "SHOPERATION_VERIFICATION_ENVIRONMENT",
      "SHOPERATION_TOOLCHAIN_ID"
    ],
    "nonSemanticPatterns": [
      "docs/**",
      "README.md",
      ".github/ISSUE_TEMPLATE/**"
    ]
  }
}
