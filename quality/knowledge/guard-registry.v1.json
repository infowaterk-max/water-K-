        "args": [
          "run",
          "market-ready:gate"
        ]
      },
      "consumesEvidenceFrom": [
        "GUARD-INCREMENTAL-REPLAY"
      ],
      "authoritySources": [
        "artifacts/shoperation-control-plane/control-plane.json"
      ],
      "controlPlaneEvidence": "artifacts/shoperation-control-plane/external-guard-market-ready.json"
    },
    {
      "id": "GUARD-QUALITY-TESTS",
      "name": "Quality Test Suite",
      "authority": "quality-knowledge-system",
      "lifecycle": "release",
      "blocking": true,
      "responsibilityKey": "automated-regression-suite",
      "producer": "npm test",
      "evidence": "test-result",
      "execution": {
        "mode": "external-specialist",
        "profiles": [
          "pr",
          "post-merge",
          "branch",
          "full-replay"
        ],
        "command": "npm",
        "args": [
          "test"
        ]
