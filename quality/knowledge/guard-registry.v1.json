      ],
      "authoritySources": [
        "artifacts/shoperation-control-plane/control-plane.json"
      ],
      "controlPlaneEvidence": "artifacts/shoperation-control-plane/external-guard-customer-baseline.json"
    },
    {
      "id": "GUARD-MARKET-READY",
      "name": "Block 24 Market Ready Contract",
      "authority": "release-infrastructure",
      "lifecycle": "release",
      "blocking": true,
      "responsibilityKey": "market-ready-contract",
      "producer": "scripts/block24-market-ready-contract.mjs",
