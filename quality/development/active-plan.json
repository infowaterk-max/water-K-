        "id": "F28-CH2",
        "scenario": "A support.manage actor is missing or has no Pro entitlement.",
        "finding": "No privileged Office or advanced Hub RPC may be invoked by a denied actor.",
        "resolution": "Fault-inject null actor and rejected plan gate and assert zero RPC invocations.",
        "status": "resolved"
      },
