        "id": "F28-CH3",
        "scenario": "Provider SQL response claims an id that differs from associated returned draftId or messageId.",
        "finding": "A merely nonempty success receipt can be forged or stale without application noticing.",
        "resolution": "Add negative success-receipt test and narrowly tighten existing source validation.",
        "status": "resolved"
      },
      {
        "id": "F28-CH4",
        "scenario": "A staff member uses actingForUserId while composing delegated customer email.",
        "finding": "Acting-for user is subject, not the actual caller; otherwise audit trail and SQL delegation can be falsified.",
        "resolution": "Verify separate p_actor and actingForUserId in RPC payload, and prove SQL error is fail closed.",
        "status": "resolved"
      },
      {
        "id": "F28-CH5",
        "scenario": "Cross-tenant customer or thread target is sent in action payload and mocked SQL returns success.",
        "finding": "Action-level provenance does not prove SQL member/read and tenant relationship constraints.",
        "resolution": "Prove actor and tenant binding in action mocks; leave native SQL same-tenant and RLS proof open.",
        "status": "resolved"
      },
      {
        "id": "F28-CH6",
        "scenario": "Advanced relationships RPC returns a valid-looking success object with wrong target or false advancedEntitlement.",
        "finding": "UI might report a relationship update despite failed entitlement or target substitution.",
        "resolution": "Verify explicit target and advancedEntitlement equality checks and fail closed on mismatches.",
        "status": "resolved"
      }
    ],
